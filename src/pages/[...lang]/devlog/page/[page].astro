---
import Base from '../../../../layouts/Base.astro';
import DevlogList from '../../../../components/DevlogList.astro';
import { getLang, langPaths, useTranslations } from '../../../../i18n/utils';
import { getPosts, POSTS_PER_PAGE, usedTags } from '../../../../lib/content';

// Page 1 is /devlog/; this route covers page 2 onward.
export async function getStaticPaths() {
  const paths = [];
  for (const { params } of langPaths()) {
    const posts = await getPosts(getLang(params.lang));
    const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
    for (let page = 2; page <= totalPages; page++) {
      paths.push({ params: { ...params, page: String(page) } });
    }
  }
  return paths;
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const page = Number(Astro.params.page);
const posts = await getPosts(lang);
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<Base lang={lang} title={`${t('devlog.title')} · ${page}`} description={t('devlog.description')}>
  <DevlogList lang={lang} posts={posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE)} page={page} totalPages={totalPages} tags={usedTags(posts)} />
</Base>
