---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TranslationNote from '../../../components/TranslationNote.astro';
import TagList from '../../../components/TagList.astro';
import { formatDate, getLang, langPaths, localePath, useTranslations } from '../../../i18n/utils';
import { getPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const { params } of langPaths()) {
    for (const post of await getPosts(getLang(params.lang))) {
      paths.push({ params: { ...params, slug: post.slug }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props;
const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await render(post);
---

<Base lang={lang} title={post.data.title} description={post.data.summary} image={post.data.cover?.src}>
  <div class="container">
    <p class="back"><a href={localePath(lang, 'devlog')}>← {t('devlog.back')}</a></p>

    <article class="panel">
      <header class="post-head">
        <h1>{post.data.title}</h1>
        <p class="date"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time></p>
        {post.data.tags.length > 0 && <TagList lang={lang} tags={post.data.tags} />}
        <hr class="lance" />
      </header>
      <TranslationNote lang={lang} translation={post.data.translation} isFallback={post.isFallback} />
      {post.data.cover && <Image src={post.data.cover} alt="" width={1200} class="cover" />}
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .back {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 1rem;
  }

  .post-head {
    text-align: center;
    padding-top: 0.5rem;
  }

  .post-head h1 {
    color: var(--text);
    margin-bottom: 0.35em;
  }

  .date {
    margin: 0 0 1rem;
    color: var(--text-muted);
  }

  /* Line the translation notice up with the text below it. */
  .panel :global(.note) {
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }

  .post-head .lance {
    width: min(28rem, 90%);
    margin: 1.75rem auto 2rem;
  }

  .back a {
    color: var(--text);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  .prose {
    margin: 0 auto;
  }
</style>
