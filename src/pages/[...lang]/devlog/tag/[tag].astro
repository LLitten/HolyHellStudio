---
// The Dev Posts page filtered to one tag. Same layout as /devlog/, with that tag's button highlighted.
import Base from '../../../../layouts/Base.astro';
import DevlogList from '../../../../components/DevlogList.astro';
import { getLang, langPaths, useTranslations } from '../../../../i18n/utils';
import { getPosts, usedTags } from '../../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const { params } of langPaths()) {
    for (const tag of usedTags(await getPosts(getLang(params.lang)))) {
      paths.push({ params: { ...params, tag } });
    }
  }
  return paths;
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const tag = Astro.params.tag!;
const all = await getPosts(lang);
const posts = all.filter((p) => p.data.tags.includes(tag as never));
---

<Base lang={lang} title={`${t(`tag.${tag}` as any)} · ${t('devlog.title')}`} description={t('devlog.description')}>
  <DevlogList lang={lang} posts={posts} page={1} totalPages={1} tags={usedTags(all)} tag={tag} />
</Base>
