---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { getLang, langPaths, useTranslations } from '../../i18n/utils';
import { getLocalized } from '../../lib/content';
import { site } from '../../site';
import emblem from '../../assets/brand/studio-logo.svg';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

// The About page uses the studio's look (flame emblem, plain borders) rather than the game's thorned frames.
const intro = (await getLocalized('studio', lang)).find((e) => e.slug === 'about');
const Intro = intro ? (await render(intro)).Content : null;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../content/team/photos/*', { eager: true });
const photo = (file?: string) => (file ? photos[`../../content/team/photos/${file}`]?.default : undefined);

const everyone = (await getCollection('team', (m) => import.meta.env.DEV || !m.data.draft)).map((m) => m.data);
const byOrder = (a: { order: number }, b: { order: number }) => a.order - b.order;
const rows = [everyone.filter((m) => m.group === 'core').sort(byOrder), everyone.filter((m) => m.group === 'team').sort(byOrder)].filter(
  (row) => row.length > 0,
);
const others = everyone.filter((m) => m.group === 'contributor');

const disciplines = (['art', 'audio', 'programming', 'design', 'other'] as const)
  .map((d) => ({
    key: d,
    label: t(`discipline.${d}`),
    people: others.filter((m) => m.discipline === d).sort((a, b) => a.order - b.order || a.name.localeCompare(b.name)),
  }))
  .filter((d) => d.people.length > 0);

const role = (r: { en: string; sc?: string; tc?: string }) => r[lang] ?? r.en;
---

<Base lang={lang} title={t('about.title')} description={t('about.description')}>
  <div class="container about">
    <section class="studio">
      <img class="emblem" src={emblem.src} width={emblem.width} height={emblem.height} alt="" />
      <h1>{t('site.studio')}</h1>
      {intro && <TranslationNote lang={lang} translation={intro.data.translation} isFallback={intro.isFallback} />}
      {Intro && <div class="intro"><Intro /></div>}
    </section>

    <section>
      <h2 class="section-title">{t('about.team')}</h2>
      {
        rows.length ? (
          rows.map((row) => (
            <ul class="team">
              {row.map((m) => {
                const img = photo(m.photo);
                return (
                  <li class="member">
                    {img ? (
                      <Image src={img} alt="" width={400} class="photo" />
                    ) : (
                      <div class="photo blank" aria-hidden="true">
                        <img src={emblem.src} alt="" />
                      </div>
                    )}
                    <h3>{m.name}</h3>
                    <p class="role">{role(m.role)}</p>
                    {m.links.length > 0 && (
                      <ul class="links">
                        {m.links.map((l) => (
                          <li>
                            <a href={l.url} target="_blank" rel="noopener">
                              {l.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>
          ))
        ) : (
          <p class="empty">{t('about.team.empty')}</p>
        )
      }
    </section>

    {
      disciplines.length > 0 && (
        <section>
          <h2 class="section-title">{t('about.contributors')}</h2>
          <p class="lede">{t('about.contributors.blurb')}</p>
          <div class="credits">
            {disciplines.map((d) => (
              <div class="discipline">
                <h3>{d.label}</h3>
                <ul>
                  {d.people.map((m) => (
                    <li>
                      {m.links[0] ? (
                        <a href={m.links[0].url} target="_blank" rel="noopener">
                          {m.name}
                        </a>
                      ) : (
                        <span class="name">{m.name}</span>
                      )}
                      <span class="credit-role">{role(m.role)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="contact" id="contact">
      <h2 class="section-title">{t('about.contact')}</h2>
      <p>{t('about.contact.body')}</p>
      <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="links">
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="me noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .about {
    max-width: 60rem;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .studio {
    padding: clamp(2.5rem, 7vw, 4rem) 0 0;
    text-align: center;
  }

  .emblem {
    display: block;
    width: 4.5rem;
    height: auto;
    margin: 0 auto 1rem;
  }

  .studio h1 {
    color: var(--text);
    margin-bottom: 1rem;
  }

  .studio :global(.note) {
    max-width: 38rem;
    margin: 0 auto 1rem;
    text-align: left;
  }

  .intro {
    max-width: 38rem;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  /* Flex rather than grid so a short last row sits in the middle. */
  .team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team + .team {
    margin-top: 1rem;
  }

  /* Plain cards in the studio's style, not the game's thorned frames. */
  .member {
    flex: 0 1 10.5rem;
    background: var(--surface);
    border: 1px solid var(--gold-dim);
    border-radius: var(--radius);
    padding: 1rem;
    text-align: center;
  }

  .photo {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    background: var(--surface-sunk);
    margin-bottom: 0.85rem;
  }

  .blank img {
    width: 38%;
    opacity: 0.35;
  }

  .member h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .role {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0.35rem 0 0.6rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }

  .empty,
  .lede {
    text-align: center;
  }

  .credits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem 2rem;
  }

  .discipline h3 {
    font-size: 1rem;
    letter-spacing: 0.06em;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--gold-dim);
    margin-bottom: 0.6rem;
  }

  .discipline ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .discipline li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.2rem 0;
  }

  .credit-role {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: right;
  }

  .contact {
    text-align: center;
  }

  .email {
    font-size: 1.15rem;
  }

  @media (max-width: 40rem) {
    .team {
      gap: 0.75rem;
    }

    .member {
      flex-basis: calc(50% - 0.375rem);
      padding: 0.75rem;
    }
  }
</style>
