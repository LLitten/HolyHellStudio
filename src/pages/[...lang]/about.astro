---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MemberCard from '../../components/MemberCard.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { getLang, langPaths, useTranslations } from '../../i18n/utils';
import { getLocalized } from '../../lib/content';
import { site } from '../../site';
import emblem from '../../assets/brand/studio-logo.svg';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

// The About page uses the studio's look (flame emblem, plain borders) rather than the game's thorned frames.
const intro = (await getLocalized('studio', lang)).find((e) => e.slug === 'about');
const Intro = intro ? (await render(intro)).Content : null;

const everyone = (await getCollection('team', (m) => import.meta.env.DEV || !m.data.draft)).map((m) => m.data);
const byOrder = (a: { order: number }, b: { order: number }) => a.order - b.order;
const core = everyone.filter((m) => m.group === 'core').sort(byOrder);
const team = everyone.filter((m) => m.group === 'team').sort(byOrder);
const extended = everyone.filter((m) => m.group === 'extended');

// Everyone is part of one team on the page; the wider team is just grouped by discipline.
const disciplines = (['art', 'audio', 'programming', 'design', 'other'] as const)
  .map((d) => ({
    key: d,
    label: t(`discipline.${d}`),
    people: extended.filter((m) => m.discipline === d).sort((a, b) => a.order - b.order || a.name.localeCompare(b.name)),
  }))
  .filter((d) => d.people.length > 0);
---

<Base lang={lang} title={t('about.title')} description={t('about.description')}>
  <div class="container about">
    <section class="studio">
      <img class="emblem" src={emblem.src} width={emblem.width} height={emblem.height} alt="" />
      <h1>{t('site.studio')}</h1>
      {intro && <TranslationNote lang={lang} translation={intro.data.translation} isFallback={intro.isFallback} />}
      {Intro && <div class="intro"><Intro /></div>}
    </section>

    <section>
      <h2 class="section-title">{t('about.team')}</h2>
      {
        everyone.length ? (
          <>
            {core.length > 0 && <ul class="team">{core.map((m) => <MemberCard lang={lang} member={m} />)}</ul>}
            {team.length > 0 && <ul class="team">{team.map((m) => <MemberCard lang={lang} member={m} />)}</ul>}
            {disciplines.map((d) => (
              <div class="discipline">
                <h3>{d.label}</h3>
                <ul class="team">
                  {d.people.map((m) => (
                    <MemberCard lang={lang} member={m} />
                  ))}
                </ul>
              </div>
            ))}
          </>
        ) : (
          <p class="empty">{t('about.team.empty')}</p>
        )
      }
    </section>

    <section class="contact" id="contact">
      <h2 class="section-title">{t('about.contact')}</h2>
      <p>{t('about.contact.body')}</p>
      <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="links">
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="me noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .about {
    max-width: 60rem;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .studio {
    padding: clamp(2.5rem, 7vw, 4rem) 0 0;
    text-align: center;
  }

  .emblem {
    display: block;
    width: 4.5rem;
    height: auto;
    margin: 0 auto 1rem;
  }

  .studio h1 {
    color: var(--text);
    margin-bottom: 1rem;
  }

  .studio :global(.note) {
    max-width: 38rem;
    margin: 0 auto 1rem;
    text-align: left;
  }

  .intro {
    max-width: 38rem;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  /* Flex rather than grid so a short last row sits in the middle. */
  .team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team + .team {
    margin-top: 1rem;
  }

  .discipline {
    margin-top: 2.25rem;
  }

  .discipline h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .discipline h3::before,
  .discipline h3::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--gold-dim);
    opacity: 0.6;
  }

  .empty {
    text-align: center;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact {
    text-align: center;
  }

  .email {
    font-size: 1.15rem;
  }

</style>
