---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLang, langPaths, useTranslations } from '../../i18n/utils';
import { site } from '../../site';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);

const photos = import.meta.glob<{ default: ImageMetadata }>('../../content/team/photos/*', { eager: true });
const photo = (file?: string) => (file ? photos[`../../content/team/photos/${file}`]?.default : undefined);

const team = (await getCollection('team', (m) => import.meta.env.DEV || !m.data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base lang={lang} title={t('about.title')} description={t('about.description')}>
  <div class="container">
    <header class="page-head">
      <h1>{t('about.title')}</h1>
    </header>

    <section class="panel studio">
      <h2>{t('about.studio')}</h2>
      <p>{t('about.studio.body')}</p>
    </section>

    <section>
      <h2 class="section-title">{t('about.team')}</h2>
      {
        team.length ? (
          <ul class="team">
            {team.map(({ data }) => {
              const img = photo(data.photo);
              return (
                <li class="member">
                  {img ? <Image src={img} alt="" width={400} class="photo" /> : <div class="photo blank" aria-hidden="true">◆</div>}
                  <h3>{data.name}</h3>
                  <p class="role">{data.role[lang] ?? data.role.en}</p>
                  {data.links.length > 0 && (
                    <ul class="links">
                      {data.links.map((l) => (
                        <li>
                          <a href={l.url} target="_blank" rel="noopener">
                            {l.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty">{t('about.team.empty')}</p>
        )
      }
    </section>

    <section class="panel contact" id="contact">
      <h2>{t('about.contact')}</h2>
      <p>{t('about.contact.body')}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="links">
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="me noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  section {
    margin-top: 2.5rem;
  }

  .studio {
    margin-top: 0;
    max-width: 48rem;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member {
    background: var(--surface);
    border: 1px solid var(--red-dim);
    border-radius: var(--radius);
    padding: 1rem;
    text-align: center;
  }

  .photo {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-sunk);
    color: var(--gold-dim);
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  h3 {
    margin: 0;
  }

  .role {
    color: var(--text-muted);
    margin: 0.25rem 0 0.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    text-align: center;
  }

  .contact {
    max-width: 48rem;
  }

  .contact .links {
    justify-content: flex-start;
  }
</style>
