---
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Crest from '../../components/Crest.astro';
import PostCard from '../../components/PostCard.astro';
import { getLang, langPaths, localePath, useTranslations } from '../../i18n/utils';
import { getPosts } from '../../lib/content';
import { site } from '../../site';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, 3);

// The finished game logo comes in two files that replace the placeholders as soon as they're added:
//   src/assets/brand/game-logo.svg   the art above the title (replaces the crest)
//   src/assets/brand/game-title.svg  the "Lost Faith" lettering, used on the English site;
//                                    add game-title-sc.svg / game-title-tc.svg for Chinese versions
// PNG works too. Until then the title is set in text.
const brand = import.meta.glob<{ default: ImageMetadata }>('../../assets/brand/game-*.{svg,png}', { eager: true });
const brandFile = (name: string) =>
  brand[`../../assets/brand/${name}.svg`]?.default ?? brand[`../../assets/brand/${name}.png`]?.default;
const logoArt = brandFile('game-logo');
const titleArt = brandFile(lang === 'en' ? 'game-title' : `game-title-${lang}`);

const loreLinks = [
  { path: 'lore/characters', label: t('lore.characters'), blurb: t('lore.characters.blurb') },
  { path: 'lore/locations', label: t('lore.locations'), blurb: t('lore.locations.blurb') },
  { path: 'lore/enemies', label: t('lore.enemies'), blurb: t('lore.enemies.blurb') },
  { path: 'lore/cards', label: t('lore.cards'), blurb: t('lore.cards.blurb') },
];
---

<Base lang={lang}>
  <section class="hero">
    <div class="container">
      {logoArt ? <img class="logo-art" src={logoArt.src} width={logoArt.width} height={logoArt.height} alt="" /> : <Crest />}
      <h1>
        {titleArt ? <img class="title-art" src={titleArt.src} width={titleArt.width} height={titleArt.height} alt={t('site.game')} /> : t('site.game')}
      </h1>
      <hr class="lance hero-lance" />
      <p class="tagline">{t('home.tagline')}</p>
      {
        site.steamUrl && (
          <a class="button" href={site.steamUrl}>
            Wishlist on Steam
          </a>
        )
      }
    </div>
  </section>

  <section class="container about">
    <div class="panel">
      <h2>{t('home.about.title')}</h2>
      <p>{t('home.about.body')}</p>
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.posts.title')}</h2>
    {
      posts.length ? (
        <div class="posts">
          {posts.map((post) => (
            <PostCard lang={lang} post={post} />
          ))}
        </div>
      ) : (
        <p class="empty">{t('devlog.empty')}</p>
      )
    }
    <p class="more"><a href={localePath(lang, 'devlog')}>{t('home.posts.all')} →</a></p>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.lore.title')}</h2>
    <ul class="lore">
      {
        loreLinks.map((l) => (
          <li>
            <a href={localePath(lang, l.path)} class="frame">
              <span class="label">{l.label}</span>
              <span class="blurb">{l.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container studio">
    <p>
      {t('home.studio')} · <a href={localePath(lang, 'about')}>{t('home.studio.link')}</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(4rem, 14vw, 9rem) 0 clamp(3rem, 8vw, 5rem);
    text-align: center;
    background: radial-gradient(ellipse at center, rgb(74 16 21 / 0.55), transparent 70%);
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 13vw, 7rem);
    font-weight: 400;
    line-height: 1;
    color: var(--gold-bright);
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.6);
    margin: 0;
  }

  :global(:lang(zh-Hans)) .hero h1,
  :global(:lang(zh-Hant)) .hero h1 {
    font-weight: 900;
    font-size: clamp(2.75rem, 10vw, 5.5rem);
    letter-spacing: 0.1em;
  }

  .logo-art {
    display: block;
    width: min(15rem, 60vw);
    height: auto;
    margin: 0 auto 0.5rem;
  }

  .title-art {
    display: block;
    width: min(32rem, 85vw);
    height: auto;
    margin: 0 auto;
  }

  .hero-lance {
    width: min(36rem, 90%);
    margin: 0.75rem auto 1.25rem;
  }

  .tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }

  section + section {
    margin-top: 3rem;
  }

  .about .panel {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .empty {
    text-align: center;
  }

  .more {
    text-align: right;
    margin-top: 1rem;
  }

  .more a {
    color: var(--text);
  }

  .lore {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lore a {
    display: block;
    height: 100%;
    padding: 1.25rem;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .lore a:hover {
    border-color: var(--gold);
  }

  .label {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--gold);
  }

  .blurb {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .studio {
    text-align: center;
  }

  .studio a {
    color: var(--text);
  }
</style>
