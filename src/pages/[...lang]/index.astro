---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getLang, langPaths, localePath, useTranslations } from '../../i18n/utils';
import { getPosts } from '../../lib/content';
import { site } from '../../site';
import logoSvg from '../../assets/brand/lost-faith-logo.svg?raw';
import frameSvg from '../../assets/brand/lost-faith-frame.svg?raw';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, 3);

// The logo files are white; drawing them inline lets CSS color them gold.
// The logo is in English, so the Chinese sites put their title inside the frame instead: the frame's top
// (arches and star) and bottom (divider and panels) are the same file cropped two ways.
const gold = (svg: string, viewBox?: string) => {
  const colored = svg.replaceAll('"white"', '"currentColor"').replace(/ width="\d+" height="\d+"/, '');
  const cropped = viewBox ? colored.replace(/viewBox="[^"]*"/, `viewBox="${viewBox}"`) : colored;
  return cropped.replace('<svg', '<svg aria-hidden="true" focusable="false"');
};
const logo = gold(logoSvg);
const frameTop = gold(frameSvg, '0 0 336 106');
const frameBottom = gold(frameSvg, '0 194 336 111');

// Title screen art from the game, copied in by `npm run sync-data`.
const heroArt = import.meta.glob<{ default: ImageMetadata }>('../../assets/game/home/title-screen.png', { eager: true })[
  '../../assets/game/home/title-screen.png'
]?.default;

const loreLinks = [
  { path: 'lore/characters', label: t('lore.characters'), blurb: t('lore.characters.blurb') },
  { path: 'lore/locations', label: t('lore.locations'), blurb: t('lore.locations.blurb') },
  { path: 'lore/enemies', label: t('lore.enemies'), blurb: t('lore.enemies.blurb') },
  { path: 'lore/cards', label: t('lore.cards'), blurb: t('lore.cards.blurb') },
];
---

<Base lang={lang}>
  <section class="hero">
    {heroArt && <Image src={heroArt} alt="" class="hero-art" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />}
    <div class="container hero-text">
      {
        lang === 'en' ? (
          <h1 class="logo">
            <Fragment set:html={logo} />
            <span class="visually-hidden">{t('site.game')}</span>
          </h1>
        ) : (
          <div class="logo">
            <Fragment set:html={frameTop} />
            <h1 class="native-title">{t('site.game')}</h1>
            <Fragment set:html={frameBottom} />
          </div>
        )
      }
      <p class="tagline">{t('home.tagline')}</p>
      <p class="pitch">{t('home.about.body')}</p>
      <div class="actions">
        {site.build && <a class="button" href={localePath(lang, 'download')}>{t('home.download')}</a>}
        {site.steamUrl && <a class="button" href={site.steamUrl}>Wishlist on Steam</a>}
      </div>
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.lore.title')}</h2>
    <ul class="lore">
      {
        loreLinks.map((l) => (
          <li>
            <a href={localePath(lang, l.path)} class="frame">
              <span class="label">{l.label}</span>
              <span class="blurb">{l.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.posts.title')}</h2>
    {
      posts.length ? (
        <div class="posts">
          {posts.map((post) => (
            <PostCard lang={lang} post={post} />
          ))}
        </div>
      ) : (
        <p class="empty">{t('devlog.empty')}</p>
      )
    }
    <p class="more"><a href={localePath(lang, 'devlog')}>{t('home.posts.all')} →</a></p>
  </section>

  <section class="container studio">
    <p>
      {t('home.studio')} · <a href={localePath(lang, 'about')}>{t('home.studio.link')}</a>
    </p>
  </section>
</Base>

<style>
  /* The title screen art fills the band; the title block sits over its open sky and valley,
     with a fade that keeps the text readable and blends the art into the page. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(46vw, 40rem);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    overflow: hidden;
    border-bottom: 1px solid var(--gold-dim);
    background: var(--surface-sunk);
  }

  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgb(19 18 22 / 0.88) 0%, rgb(19 18 22 / 0.7) 32%, rgb(19 18 22 / 0) 62%),
      linear-gradient(to top, rgb(19 18 22 / 0.85), rgb(19 18 22 / 0) 35%);
  }

  .hero::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -8px;
    z-index: 2;
    width: 16px;
    height: 16px;
    transform: translateX(-50%);
    background: var(--lance-node) center / contain no-repeat;
  }

  .hero-text {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero-text > * {
    max-width: 30rem;
  }

  @media (min-width: 50rem) {
    .hero-text > * {
      margin-left: 0;
      margin-right: 0;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: fit-content;
      margin-left: max(var(--gutter), calc((100vw - var(--width)) / 2 + var(--gutter)));
    }
  }

  /* On narrow screens the art still fills the band, cropped in on the character, and the title
     sits over its lower half behind a fade. */
  @media (max-width: 49.99rem) {
    .hero {
      display: block;
      min-height: 0;
      padding-top: 62vw;
    }

    .hero-art {
      object-position: 72% 0%;
    }

    .hero::before {
      background: linear-gradient(to top, rgb(19 18 22 / 0.92) 0%, rgb(19 18 22 / 0.8) 45%, rgb(19 18 22 / 0) 75%);
    }

    .hero-text > * {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .logo {
    width: min(22rem, 78vw);
    margin: 0 auto 1rem;
    color: var(--gold);
    filter: drop-shadow(0 2px 14px rgb(0 0 0 / 0.6));
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .native-title {
    margin: 0.4rem 0 0.2rem;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 11vw, 3.6rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.12em;
    color: var(--gold);
  }

  .tagline {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    color: var(--gold);
    letter-spacing: 0.04em;
  }

  .pitch {
    margin: 0 auto;
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .actions:empty {
    display: none;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .empty {
    text-align: center;
  }

  .more {
    text-align: right;
    margin-top: 1rem;
  }

  .more a {
    color: var(--text);
  }

  .lore {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .lore {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .lore a {
      padding: 1rem;
    }

    .blurb {
      font-size: 0.85rem;
    }
  }

  .lore a {
    display: block;
    height: 100%;
    padding: 1.25rem;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .lore a:hover {
    border-color: var(--gold);
  }

  .label {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--gold);
  }

  .blurb {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .studio {
    text-align: center;
  }

  .studio a {
    color: var(--text);
  }
</style>
