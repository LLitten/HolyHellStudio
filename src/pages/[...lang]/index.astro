---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Crest from '../../components/Crest.astro';
import PostCard from '../../components/PostCard.astro';
import { getLang, langPaths, localePath, useTranslations } from '../../i18n/utils';
import { getPosts } from '../../lib/content';
import { site } from '../../site';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, 3);

// The finished game logo comes in two files that replace the placeholders as soon as they're added:
//   src/assets/brand/game-logo.svg   the art above the title (replaces the crest)
//   src/assets/brand/game-title.svg  the "Lost Faith" lettering, used on the English site;
//                                    add game-title-sc.svg / game-title-tc.svg for Chinese versions
// PNG works too. Until then the title is set in text.
const brand = import.meta.glob<{ default: ImageMetadata }>('../../assets/brand/game-*.{svg,png}', { eager: true });
const brandFile = (name: string) =>
  brand[`../../assets/brand/${name}.svg`]?.default ?? brand[`../../assets/brand/${name}.png`]?.default;
const logoArt = brandFile('game-logo');
const titleArt = brandFile(lang === 'en' ? 'game-title' : `game-title-${lang}`);

// Title screen art from the game, copied in by `npm run sync-data`.
const heroArt = import.meta.glob<{ default: ImageMetadata }>('../../assets/game/home/title-screen.png', { eager: true })[
  '../../assets/game/home/title-screen.png'
]?.default;

const loreLinks = [
  { path: 'lore/characters', label: t('lore.characters'), blurb: t('lore.characters.blurb') },
  { path: 'lore/locations', label: t('lore.locations'), blurb: t('lore.locations.blurb') },
  { path: 'lore/enemies', label: t('lore.enemies'), blurb: t('lore.enemies.blurb') },
  { path: 'lore/cards', label: t('lore.cards'), blurb: t('lore.cards.blurb') },
];
---

<Base lang={lang}>
  <section class="hero">
    {heroArt && <Image src={heroArt} alt="" class="hero-art" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />}
    <div class="container hero-text">
      {logoArt ? <img class="logo-art" src={logoArt.src} width={logoArt.width} height={logoArt.height} alt="" /> : <Crest />}
      <h1>
        {titleArt ? <img class="title-art" src={titleArt.src} width={titleArt.width} height={titleArt.height} alt={t('site.game')} /> : t('site.game')}
      </h1>
      <hr class="lance hero-lance" />
      <p class="tagline">{t('home.tagline')}</p>
      <p class="pitch">{t('home.about.body')}</p>
      <div class="actions">
        {site.build && <a class="button" href={localePath(lang, 'download')}>{t('home.download')}</a>}
        {site.steamUrl && <a class="button" href={site.steamUrl}>Wishlist on Steam</a>}
      </div>
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.lore.title')}</h2>
    <ul class="lore">
      {
        loreLinks.map((l) => (
          <li>
            <a href={localePath(lang, l.path)} class="frame">
              <span class="label">{l.label}</span>
              <span class="blurb">{l.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container">
    <h2 class="section-title">{t('home.posts.title')}</h2>
    {
      posts.length ? (
        <div class="posts">
          {posts.map((post) => (
            <PostCard lang={lang} post={post} />
          ))}
        </div>
      ) : (
        <p class="empty">{t('devlog.empty')}</p>
      )
    }
    <p class="more"><a href={localePath(lang, 'devlog')}>{t('home.posts.all')} →</a></p>
  </section>

  <section class="container studio">
    <p>
      {t('home.studio')} · <a href={localePath(lang, 'about')}>{t('home.studio.link')}</a>
    </p>
  </section>
</Base>

<style>
  /* The title screen art fills the band; the title block sits over its open sky and valley,
     with a fade that keeps the text readable and blends the art into the page. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(46vw, 40rem);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    overflow: hidden;
    border-bottom: 1px solid var(--gold-dim);
    background: var(--surface-sunk);
  }

  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgb(19 18 22 / 0.88) 0%, rgb(19 18 22 / 0.7) 32%, rgb(19 18 22 / 0) 62%),
      linear-gradient(to top, rgb(19 18 22 / 0.85), rgb(19 18 22 / 0) 35%);
  }

  .hero::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -8px;
    z-index: 2;
    width: 16px;
    height: 16px;
    transform: translateX(-50%);
    background: var(--lance-node) center / contain no-repeat;
  }

  .hero-text {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero-text > * {
    max-width: 30rem;
  }

  @media (min-width: 50rem) {
    .hero-text > * {
      margin-left: 0;
      margin-right: 0;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: fit-content;
      margin-left: max(var(--gutter), calc((100vw - var(--width)) / 2 + var(--gutter)));
    }
  }

  /* On narrow screens the art becomes a banner above the title. */
  @media (max-width: 49.99rem) {
    .hero {
      display: block;
      min-height: 0;
      padding-top: 56vw;
    }

    .hero-art {
      height: 64vw;
      object-position: 75% 30%;
    }

    .hero::before {
      background: linear-gradient(to top, var(--surface-sunk) 30%, rgb(19 18 22 / 0) 62%);
    }

    .hero-text > * {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 13vw, 7rem);
    font-weight: 400;
    line-height: 1;
    color: var(--gold-bright);
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.6);
    margin: 0;
  }

  :global(:lang(zh-Hans)) .hero h1,
  :global(:lang(zh-Hant)) .hero h1 {
    font-weight: 900;
    font-size: clamp(2.75rem, 10vw, 5.5rem);
    letter-spacing: 0.1em;
  }

  .logo-art {
    display: block;
    width: min(15rem, 60vw);
    height: auto;
    margin: 0 auto 0.5rem;
  }

  .title-art {
    display: block;
    width: min(32rem, 85vw);
    height: auto;
    margin: 0 auto;
  }

  .hero-lance {
    width: min(36rem, 90%);
    margin: 0.5rem auto 1rem;
  }

  .tagline {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    color: var(--gold);
    letter-spacing: 0.04em;
  }

  .pitch {
    margin: 0 auto;
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .actions:empty {
    display: none;
  }

  section + section {
    margin-top: 3.5rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .empty {
    text-align: center;
  }

  .more {
    text-align: right;
    margin-top: 1rem;
  }

  .more a {
    color: var(--text);
  }

  .lore {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .lore {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .lore a {
      padding: 1rem;
    }

    .blurb {
      font-size: 0.85rem;
    }
  }

  .lore a {
    display: block;
    height: 100%;
    padding: 1.25rem;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .lore a:hover {
    border-color: var(--gold);
  }

  .label {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--gold);
  }

  .blurb {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .studio {
    text-align: center;
  }

  .studio a {
    color: var(--text);
  }
</style>
