---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import LoreShell from '../../../../components/LoreShell.astro';
import Infobox from '../../../../components/Infobox.astro';
import TranslationNote from '../../../../components/TranslationNote.astro';
import { characterArt } from '../../../../credits';
import { getLang, langPaths, useTranslations } from '../../../../i18n/utils';
import { getLocalized } from '../../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const { params } of langPaths()) {
    for (const character of await getLocalized('characters', getLang(params.lang))) {
      paths.push({ params: { ...params, slug: character.slug }, props: { character } });
    }
  }
  return paths;
}

const { character } = Astro.props;
const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await render(character);
const artist = characterArt[character.slug];
---

<Base lang={lang} title={character.data.name}>
  <LoreShell lang={lang} current={`characters/${character.slug}`}>
    <div class="entry">
      <h1 class="title">{character.data.name}</h1>
      <div class="infobox">
        <Infobox title={character.data.name} image={character.data.portrait} rows={character.data.infobox} credit={artist && t('credit.art', { name: artist })} />
      </div>
      <div class="text">
        <TranslationNote lang={lang} translation={character.data.translation} isFallback={character.isFallback} />
        <div class="prose"><Content /></div>
      </div>
    </div>
  </LoreShell>
</Base>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    grid-template-areas: 'title infobox' 'text infobox';
    grid-template-rows: auto 1fr;
    gap: 1rem 2rem;
    align-items: start;
  }

  .infobox {
    grid-area: infobox;
    align-self: start;
  }

  .text {
    grid-area: text;
  }

  .title {
    grid-area: title;
    margin: 0;
    color: var(--text);
  }

  @media (max-width: 60rem) {
    .entry {
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'infobox' 'text';
      grid-template-rows: auto;
    }

    .infobox {
      width: 100%;
      max-width: 26rem;
    }

    /* The page title already names the character. */
    .infobox :global(.infobox h2) {
      display: none;
    }
  }
</style>
