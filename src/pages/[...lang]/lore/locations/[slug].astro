---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import LoreShell from '../../../../components/LoreShell.astro';
import EnemyGrid from '../../../../components/EnemyGrid.astro';
import TranslationNote from '../../../../components/TranslationNote.astro';
import { getLang, langPaths, useTranslations } from '../../../../i18n/utils';
import { getLocalized } from '../../../../lib/content';
import { enemies, locations } from '../../../../lib/game';

export async function getStaticPaths() {
  const paths = [];
  for (const { params } of langPaths()) {
    for (const location of await getLocalized('locations', getLang(params.lang))) {
      paths.push({ params: { ...params, slug: location.slug }, props: { location } });
    }
  }
  return paths;
}

const { location } = Astro.props;
const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await render(location);

const data = locations.find((l) => l.group === location.data.dungeonGroup);
const dungeonIds = new Set(data?.dungeons.map((d) => d.id));
const found = enemies.filter((e) => e.variants.some((v) => v.dungeons.some((d) => dungeonIds.has(d))));
---

<Base lang={lang} title={location.data.name} description={location.data.summary}>
  <LoreShell lang={lang} current={`locations/${location.slug}`}>
    {location.data.banner && <Image src={location.data.banner} alt="" width={1200} class="banner" />}
    <h1>{location.data.name}</h1>
    <TranslationNote lang={lang} translation={location.data.translation} isFallback={location.isFallback} />
    <div class="prose"><Content /></div>

    {
      data && data.dungeons.length > 0 && (
        <section>
          <h2>{t('location.areas')}</h2>
          <dl class="areas">
            {data.dungeons.map((d) => (
              <div class="panel">
                <dt>{d.name[lang]}</dt>
                {d.description[lang] && <dd>{d.description[lang]}</dd>}
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      found.length > 0 && (
        <section>
          <h2>{t('location.enemies')}</h2>
          <EnemyGrid lang={lang} enemies={found} />
        </section>
      )
    }
  </LoreShell>
</Base>

<style>
  .banner {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  h1 {
    color: var(--text);
  }

  section {
    margin-top: 2.5rem;
  }

  h2 {
    color: var(--text);
  }

  .areas {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .areas .panel {
    padding: 1rem 1.25rem;
  }

  dt {
    font-family: var(--font-heading);
    color: var(--gold);
  }

  dd {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-style: italic;
  }
</style>
