---
import Base from '../../../../layouts/Base.astro';
import LoreShell from '../../../../components/LoreShell.astro';
import EnemyGrid from '../../../../components/EnemyGrid.astro';
import { getLang, langPaths, useTranslations } from '../../../../i18n/utils';
import { enemyAreas } from '../../../../lib/game';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('lore.enemies')}>
  <LoreShell lang={lang} current="enemies">
    <h1>{t('lore.enemies')}</h1>
    <p class="scope-note">{t('lore.scope')}</p>
    {
      enemyAreas
        .filter((a) => a.enemies.length > 0)
        .map((a) => (
          <section>
            <h2 id={a.slug}>{a.name[lang]}</h2>
            <EnemyGrid lang={lang} enemies={a.enemies} />
          </section>
        ))
    }
  </LoreShell>
</Base>

<style>
  h1 {
    color: var(--text);
  }

  h2 {
    scroll-margin-top: 1rem;
  }

  section + section {
    margin-top: 2.5rem;
  }
</style>
