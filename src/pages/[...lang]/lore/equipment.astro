---
import Base from '../../../layouts/Base.astro';
import LoreShell from '../../../components/LoreShell.astro';
import ItemPage from '../../../components/ItemPage.astro';
import { getLang, langPaths, useTranslations } from '../../../i18n/utils';
import { items } from '../../../lib/game';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('lore.equipment')} description={t('lore.equipment.blurb')}>
  <LoreShell lang={lang} current="equipment">
    <ItemPage lang={lang} title={t('lore.equipment')} items={items.filter((i) => i.kind === 'equipment')} order={['Offense', 'Defense', 'Other']} />
  </LoreShell>
</Base>
