---
import Base from '../../../layouts/Base.astro';
import LoreShell from '../../../components/LoreShell.astro';
import ItemFilters from '../../../components/ItemFilters.astro';
import ItemPage from '../../../components/ItemPage.astro';
import { getLang, langPaths, useTranslations } from '../../../i18n/utils';
import { items } from '../../../lib/game';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const materials = items.filter((i) => i.kind === 'material');
const order = ['CardPack', 'SoulFragment', 'Material', 'RareMaterial'];
---

<Base lang={lang} title={t('lore.materials')} description={t('lore.materials.blurb')}>
  <LoreShell lang={lang} current="materials">
    <ItemFilters lang={lang} items={materials} order={order} slot="side" />
    <ItemPage lang={lang} title={t('lore.materials')} items={materials} order={order} />
  </LoreShell>
</Base>
