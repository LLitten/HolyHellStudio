---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  value: number;
}

const { lang, value } = Astro.props;
const t = useTranslations(lang);
const tier = Math.min(Math.max(value, 1), 5);
---

<span class="rarity" style={`--tier: var(--rarity-${tier})`} title={t('rarity.value', { n: value })}>
  <span aria-hidden="true">{'◆'.repeat(Math.max(value, 1))}</span>
  <span class="visually-hidden">{t('rarity.value', { n: value })}</span>
</span>

<style>
  .rarity {
    color: var(--tier);
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
