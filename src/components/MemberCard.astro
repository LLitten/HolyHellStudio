---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LinkIcon from './LinkIcon.astro';

interface Props {
  lang: Lang;
  member: {
    name: string;
    role: { en: string; sc?: string; tc?: string };
    photo?: string;
    links: { label: string; url: string }[];
  };
}

const { lang, member } = Astro.props;
const t = useTranslations(lang);
const linkName = (url: string) =>
  t(new URL(url).hostname.endsWith('artstation.com') ? 'about.link.artstation' : 'about.link.site', { name: member.name });

// Photos are optional; without one the card is just name, role and links.
const photos = import.meta.glob<{ default: ImageMetadata }>('../content/team/photos/*', { eager: true });
const img = member.photo ? photos[`../content/team/photos/${member.photo}`]?.default : undefined;
---

<li class="member">
  {img && <Image src={img} alt="" width={400} class="photo" />}
  <h3>{member.name}</h3>
  <p class="role">{member.role[lang] ?? member.role.en}</p>
  {
    member.links.length > 0 && (
      <ul class="links">
        {member.links.map((l) => (
          <li>
            <a
              href={l.url}
              target="_blank"
              rel="noopener"
              aria-label={linkName(l.url)}
              title={linkName(l.url)}
            >
              <LinkIcon url={l.url} />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>

<style>
  .member {
    flex: 0 1 12rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--gold-dim);
    border-top: 2px solid var(--gold);
    border-radius: var(--radius);
    padding: 1.1rem 1rem;
    text-align: center;
  }

  .photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 0.85rem;
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .role {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0.35rem 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.75rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: block;
    padding: 0.2rem;
    color: var(--gold);
    border-radius: var(--radius);
  }

  .links a:hover {
    color: var(--gold-bright);
  }

  @media (max-width: 40rem) {
    .member {
      flex-basis: calc(50% - 0.5rem);
      padding: 0.9rem 0.75rem;
    }
  }
</style>
