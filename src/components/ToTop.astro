---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<a class="to-top" href="#content" aria-label={t('nav.top')} title={t('nav.top')}>↑</a>

<style>
  /* For long grid pages, mostly so phones don't have to scroll all the way back up. */
  .to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 1px solid var(--gold-dim);
    color: var(--gold);
    font-size: 1.25rem;
    text-decoration: none;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.5);
  }

  .to-top:hover {
    color: var(--gold-bright);
    border-color: var(--gold);
  }
</style>
