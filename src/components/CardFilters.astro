---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { cards, GOD_ORDER, term } from '../lib/game';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Only offer values that some card actually has.
const has = (pick: (c: (typeof cards)[number]) => (string | number)[]) => new Set(cards.flatMap(pick).map(String));
const factions = ['Angel', 'Demon', 'Neutral'].filter((f) => has((c) => c.factions).has(f));
const rarities = [...has((c) => [c.rarity])].map(Number).sort((a, b) => a - b);
const costs = [...has((c) => [Math.min(c.cost, 3)])].map(Number).sort((a, b) => a - b);
const types = [...has((c) => c.actionTypes)];

const groups = [
  {
    name: 'god',
    label: t('card.god'),
    options: [
      { value: 'inherent', label: t('cards.inherent') },
      ...GOD_ORDER.map((g) => ({ value: g, label: term('gods', g, lang) })),
    ],
  },
  { name: 'faction', label: t('card.faction'), options: factions.map((f) => ({ value: f, label: term('factions', f, lang) })) },
  {
    name: 'rarity',
    label: t('rarity'),
    options: rarities.map((r) => ({ value: String(r), label: '◆'.repeat(r), title: t('rarity.value', { n: r }), tier: r })),
  },
  { name: 'cost', label: t('card.cost'), options: costs.map((c) => ({ value: String(c), label: c === 3 ? '3+' : String(c) })) },
  { name: 'type', label: t('card.type'), options: types.map((a) => ({ value: a, label: term('actionTypes', a, lang) })) },
];
---

<section class="filters frame" hidden data-card-filters>
  <h2>{t('filter.title')} <span class="active-count" data-active-count></span></h2>
  <form>
    {
      groups.map((g) => (
        <details data-filter-group>
          <summary>
            {g.label} <span class="active-count" data-group-count></span>
          </summary>
          <fieldset>
            <legend class="visually-hidden">{g.label}</legend>
            <div class="chips">
              {g.options.map((o: { value: string; label: string; title?: string; tier?: number }) => (
                <label class="chip" title={o.title}>
                  <input type="checkbox" name={g.name} value={o.value} />
                  <span style={o.tier ? `color: var(--rarity-${o.tier})` : undefined}>
                    {o.title ? (
                      <>
                        <span aria-hidden="true">{o.label}</span>
                        <span class="visually-hidden">{o.title}</span>
                      </>
                    ) : (
                      o.label
                    )}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        </details>
      ))
    }
    <div class="foot">
      <p class="count" aria-live="polite" data-count data-template={t('filter.count')}></p>
      <button type="reset" class="clear">{t('filter.clear')}</button>
    </div>
  </form>
</section>

<script>
  // Cards match when they fit every filter group that has something selected;
  // within a group, any selected value counts. The choice is kept in the URL so a filtered view can be shared.
  const panel = document.querySelector<HTMLElement>('[data-card-filters]');
  const form = panel?.querySelector('form');

  if (panel && form) {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-card-group]')];
    const names = ['god', 'faction', 'rarity', 'cost', 'type'];
    const count = panel.querySelector<HTMLElement>('[data-count]')!;
    const activeCount = panel.querySelector<HTMLElement>('[data-active-count]')!;
    const none = document.querySelector<HTMLElement>('[data-none]')!;
    const total = new Set(cards.map((c) => c.dataset.card)).size;

    const update = () => {
      const data = new FormData(form);
      const chosen = names.map((name) => [name, data.getAll(name) as string[]] as const);

      const visible = new Set<string>();
      for (const card of cards) {
        const show = chosen.every(
          ([name, values]) => !values.length || card.dataset[name]!.split(' ').some((v) => values.includes(v)),
        );
        card.hidden = !show;
        if (show) visible.add(card.dataset.card!);
      }

      for (const group of groups) {
        group.hidden = !group.querySelector('[data-card]:not([hidden])');
      }

      for (const section of panel.querySelectorAll<HTMLElement>('[data-filter-group]')) {
        const n = section.querySelectorAll('input:checked').length;
        section.querySelector('[data-group-count]')!.textContent = n ? `(${n})` : '';
      }

      const active = chosen.reduce((n, [, values]) => n + values.length, 0);
      count.textContent = count.dataset.template!.replace('{n}', String(visible.size)).replace('{total}', String(total));
      activeCount.textContent = active ? `(${active})` : '';
      none.hidden = visible.size > 0;

      const params = new URLSearchParams();
      for (const [name, values] of chosen) for (const v of values) params.append(name, v);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname + location.hash);
    };

    // Pick up filters from a shared link.
    const params = new URLSearchParams(location.search);
    for (const input of form.querySelectorAll<HTMLInputElement>('input')) {
      input.checked = params.getAll(input.name).includes(input.value);
    }

    // Sections start folded, except ones a shared link already set.
    for (const section of panel.querySelectorAll<HTMLDetailsElement>('[data-filter-group]')) {
      section.open = !!section.querySelector('input:checked');
    }

    form.addEventListener('change', update);
    form.addEventListener('reset', () => setTimeout(update));
    panel.hidden = false;
    update();
  }
</script>

<style>
  .filters {
    margin-top: 1rem;
    padding: 0.75rem 1rem 1rem;
    background: var(--surface);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: var(--gold);
  }

  .active-count {
    color: var(--text-muted);
    font-size: 0.85em;
  }

  details {
    border-top: 1px solid var(--demon-dim);
  }

  summary {
    padding: 0.45rem 0;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--text);
  }

  summary:hover {
    color: var(--gold-bright);
  }

  fieldset {
    margin: 0;
    padding: 0 0 0.6rem;
    border: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip > span {
    display: block;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--gold-dim);
    border-radius: 2px;
    background: var(--surface-sunk);
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    line-height: 1.3;
    cursor: pointer;
    user-select: none;
  }

  .chip:hover > span {
    border-color: var(--gold);
  }

  .chip input:checked + span {
    border-color: var(--gold);
    background: linear-gradient(to bottom, var(--demon-shade), var(--demon-shade-dark));
    color: var(--gold-bright);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--gold-bright);
    outline-offset: 2px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--demon-dim);
  }

  .count {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .clear {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--gold-dim);
    border-radius: 2px;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .clear:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
  }

</style>
