---
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import logo from '../assets/brand/studio-logo.svg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: localePath(lang), label: t('nav.home'), match: (p: string) => p === localePath(lang) },
  { href: localePath(lang, 'lore'), label: t('nav.lore') },
  { href: localePath(lang, 'devlog'), label: t('nav.devlog') },
  { href: localePath(lang, 'about'), label: t('nav.about') },
];

const path = Astro.url.pathname;
const isCurrent = (link: (typeof links)[number]) => (link.match ? link.match(path) : path.startsWith(link.href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(lang)}>
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span>{t('site.studio')}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguagePicker lang={lang} />
  </div>
</header>

<style>
  .site-header {
    background: var(--surface-sunk);
    border-bottom: 1px solid var(--gold-dim);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.06em;
    margin-right: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand img {
    height: 2.4rem;
    width: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-heading);
    color: var(--text);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a[aria-current] {
    color: var(--gold-bright);
    border-bottom-color: var(--gold-dim);
  }

  @media (max-width: 40rem) {
    .bar {
      gap: 0.5rem 0.75rem;
    }

    .brand {
      font-size: 1.05rem;
      gap: 0.45rem;
    }

    .brand img {
      height: 2rem;
    }

    nav {
      order: 3;
      width: 100%;
    }

    nav ul {
      justify-content: space-between;
    }
  }
</style>
