---
// Icon for a team member's link: the ArtStation logo for ArtStation, a meeple bust for any other site.
interface Props {
  url: string;
}

const host = new URL(Astro.props.url).hostname.replace(/^www\./, '');
const kind = host.endsWith('artstation.com') ? 'artstation' : 'site';
---

{
  kind === 'artstation' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M0 17.723l2.027 3.505h.001a2.424 2.424 0 0 0 2.164 1.333h13.457l-2.792-4.838H0zm24 .025c0-.484-.143-.935-.388-1.314L15.728 2.728a2.424 2.424 0 0 0-2.142-1.289H9.419L21.598 22.54l1.92-3.325c.378-.637.482-.919.482-1.467zm-11.129-3.462L7.428 4.858l-5.444 9.428h10.887z" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 1.5a4.8 4.8 0 0 0-3.1 8.5c-3.6.7-6.9 2.4-7.4 4.8-.3 1.4.6 2.6 2 2.7l2.8.2c.8 2.1 1 3.8.9 4.8h9.6c-.1-1 .1-2.7.9-4.8l2.8-.2c1.4-.1 2.3-1.3 2-2.7-.5-2.4-3.8-4.1-7.4-4.8A4.8 4.8 0 0 0 12 1.5z" />
    </svg>
  )
}

<style>
  svg {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }
</style>
