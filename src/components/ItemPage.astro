---
// Shared body of the Equipment and Materials pages: items grouped by sub-type, with jump links.
import type { Lang } from '../i18n/ui';
import { iconArt } from '../credits';
import { useTranslations } from '../i18n/utils';
import type { Item } from '../lib/game';
import ItemTile from './ItemTile.astro';
import ToTop from './ToTop.astro';

interface Props {
  lang: Lang;
  title: string;
  items: Item[];
  order: string[];
}

const { lang, title, items, order } = Astro.props;
const t = useTranslations(lang);

const groups = order
  .map((subType) => ({
    id: subType.toLowerCase(),
    label: t(`subtype.${subType}` as any),
    items: items.filter((i) => i.subType === subType).sort((a, b) => a.rarity - b.rarity || a.id.localeCompare(b.id)),
  }))
  .filter((g) => g.items.length > 0);
---

<h1>{title}</h1>
<p class="scope-note">{t('lore.scope')}<br /><span class="credit">{t('credit.icons', { name: iconArt })}</span></p>

<nav aria-label={t('lore.jump')}>
  <ul class="jump">
    {groups.map((g) => <li><a href={`#${g.id}`}>{g.label} ({g.items.length})</a></li>)}
  </ul>
</nav>

{
  groups.map((g) => (
    <section class="group">
      <h2 id={g.id}>{g.label}</h2>
      <div class="tile-grid">
        {g.items.map((item) => (
          <ItemTile lang={lang} item={item} />
        ))}
      </div>
    </section>
  ))
}

<ToTop lang={lang} />

<style>
  h1 {
    color: var(--text);
  }
</style>
